{
  "include": [
    "src",
    "tests",
    "scripts",
    "run.py",
    "test_live.py"
  ],
  "exclude": [
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**",
    "**/.pytest_cache/**",
    "**/__pycache__/**"
  ],
  "extraPaths": [
    "src"
  ],
  "executionEnvironments": [
    {
      "root": "src",
      "extraPaths": [
        "src"
      ]
    }
  ],
  "pythonVersion": "3.12",
  "pythonPlatform": "Windows",
  "reportMissingImports": false,
  "reportMissingModuleSource": false,
  "reportUndefinedVariable": false
}
